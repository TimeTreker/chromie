# Copy to orchestrator/.env.local and adjust for your host.
#
# This file is loaded after the generated .env.runtime without overriding it,
# and after the launcher exports. Any key defined in .env.common, an
# env/modes/*.env file, or the detected hardware profile therefore wins over
# this file; set those in the root .env.local instead. Only host-local keys
# that no generated source defines (endpoints, audio devices, VAD) belong here.
# TTS_URL and TTS_SPEAKER_ID are selected per TTS backend by the launchers.

# Host service endpoints. These match the application defaults and can be
# changed when services run on another host. LLM_URL is an Ollama-native
# /api/generate endpoint used only for generated ready-greeting speech.
ASR_URL=ws://127.0.0.1:9001
LLM_URL=http://127.0.0.1:11434/api/generate

# Speech / TTS
ORCH_TTS_WS_RETRIES=2
ORCH_TTS_WS_RETRY_DELAY_MS=300
ORCH_VOICE_SYSTEM_PROMPT=You are a real-time voice assistant. Answer briefly in 1 to 3 short sentences. Do not use markdown.

# Audio / VAD
# Empty/default/auto follows OS device changes while running; an explicit
# unavailable name or index stays pinned and fails rather than falling back.
ORCH_INPUT_DEVICE=
ORCH_OUTPUT_DEVICE=
ORCH_INPUT_RATE=48000
ORCH_OUTPUT_RATE=48000
ORCH_INPUT_CHANNELS=1
ORCH_OUTPUT_CHANNELS=2
ORCH_INPUT_BLOCK_MS=30
ORCH_OUTPUT_BLOCK_MS=30
ORCH_INPUT_LATENCY=low
ORCH_OUTPUT_LATENCY=low
ORCH_VAD_MODE=3
ORCH_VAD_SILENCE_MS=650
ORCH_MIN_AUDIO_MS=450
ORCH_VAD_MAX_UTTERANCE_MS=20000
ORCH_MIN_RMS=120
ORCH_BARGE_IN_MIN_RMS=350
ORCH_PLAYBACK_CHUNK_MS=80

# Debugging
RECORDINGS_DIR=recordings
