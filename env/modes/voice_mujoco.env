CHROMIE_OPERATOR_MODE=voice_mujoco
ORCH_ENABLE_AGENT=1
ORCH_ENABLE_INTERACTION_RESPONSE=1
ORCH_ENABLE_SORIDORMI_CAPABILITIES=1
ORCH_COGNITIVE_RUNTIME_MODE=apply
ORCH_ACTION_DRY_RUN=false

# Human-facing interaction budgets. Hardware profiles choose models/context;
# operator mode owns foreground latency. Explicit validation/qualification modes
# may override these with longer evidence-collection watchdogs.
CHROMIE_COGNITIVE_BUDGET_PROFILE=interactive
AGENT_COGNITIVE_GATEWAY_ATTENTION_TIMEOUT_MS=2500
AGENT_GOAL_INTERPRETER_TIMEOUT_MS=5400
# Fast Planner emits an early typed PresentationCommit from the same streamed
# semantic result that later carries terminal planning. The timeout therefore
# bounds the complete structured invocation, not only its human-facing commit.
AGENT_GOAL_ASSOCIATION_TIMEOUT_MS=8000
AGENT_FAST_PLANNER_TIMEOUT_MS=8000
AGENT_DEEP_PLANNER_TIMEOUT_MS=9000
ORCH_GOAL_ASSOCIATION_TIMEOUT_MS=9000
ORCH_FAST_PLANNER_TIMEOUT_MS=9000
ORCH_DEEP_PLANNER_TIMEOUT_MS=10000
ORCH_COGNITIVE_RUNTIME_TIMEOUT_MS=15000
ORCH_TTS_PLAYBACK_START_TIMEOUT_MS=3500
