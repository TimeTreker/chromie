CHROMIE_OPERATOR_MODE=qualification
ORCH_ENABLE_AGENT=1
ORCH_ENABLE_INTERACTION_RESPONSE=1
ORCH_ENABLE_SORIDORMI_CAPABILITIES=1
ORCH_COGNITIVE_RUNTIME_MODE=apply
ORCH_ACTION_DRY_RUN=true
ORCH_SESSION_TIMING_LOGS=1
ORCH_COGNITIVE_EVIDENCE_ENABLED=1

# Qualification intentionally favors complete retained evidence over human-facing
# latency. These long watchdogs belong to this explicit operator mode, not to a
# hardware profile used by normal speech interaction.
CHROMIE_COGNITIVE_BUDGET_PROFILE=qualification
AGENT_COGNITIVE_GATEWAY_ATTENTION_TIMEOUT_MS=120000
AGENT_GOAL_INTERPRETER_TIMEOUT_MS=120000
AGENT_GOAL_INTERPRETER_WARM_LLM_TIMEOUT_MS=120000
AGENT_SKILL_SELECTION_TIMEOUT_MS=120000
AGENT_EXTERNAL_INFORMATION_TIMEOUT_MS=120000
AGENT_GOAL_ASSOCIATION_TIMEOUT_MS=120000
AGENT_FAST_PLANNER_TIMEOUT_MS=120000
AGENT_FAST_FIRST_RESPONSE_TIMEOUT_MS=120000
AGENT_DEEP_PLANNER_TIMEOUT_MS=120000
# The retained full-catalog post-Evidence prompt requires about 36K tokens with
# its 4K structured-output reserve. Keep this larger context qualification-only
# so architecture validation is not confused with the interactive latency profile.
AGENT_DEEP_PLANNER_NUM_CTX=40960
AGENT_TASK_CONTINUITY_TIMEOUT_MS=120000
ORCH_AGENT_GOAL_INTERPRETER_TIMEOUT_MS=150000
ORCH_GOAL_ASSOCIATION_TIMEOUT_MS=150000
ORCH_FAST_PLANNER_TIMEOUT_MS=150000
ORCH_DEEP_PLANNER_TIMEOUT_MS=150000
ORCH_TASK_CONTINUITY_TIMEOUT_MS=150000
ORCH_COGNITIVE_RUNTIME_TIMEOUT_MS=900000
ORCH_TTS_PLAYBACK_START_TIMEOUT_MS=120000
AGENT_TIMEOUT_MS=240000
ORCH_AGENT_TIMEOUT_MS=300000
