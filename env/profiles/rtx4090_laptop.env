# RTX 4090 Laptop GPU profile (typically 16GB VRAM)
CHROMIE_HARDWARE_PROFILE=rtx4090_laptop
CHROMIE_ARCH=x86_64
CHROMIE_GPU_VENDOR=nvidia
CHROMIE_GPU_CLASS=laptop

TTS_CUDA_ARCH=89

ASR_MODEL=/root/.cache/huggingface/sherpa-onnx/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-int8-2024-07-17
ASR_MODEL_REVISION=asr-models/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-int8-2024-07-17

# Keep the current Qwen3.5 4B cognitive identity while changing only the serving
# runtime. The maintained SGLang service owns model residency, independent request
# contexts and provider scheduling; semantic role authority remains unchanged.
AGENT_MODEL=qwen3.5:4b
OLLAMA_MODEL=qwen3.5:4b
AGENT_LLM_PROVIDER=sglang
AGENT_SGLANG_URL=http://chromie-llm:30000/v1
CHROMIE_COMPOSE_OVERRIDE_FILES=docker-compose.sglang-rtx4090-laptop.yml
WARM_OLLAMA_BEFORE_ORCH=0
ORCH_PRESENTATION_COMPUTE_LEASE_ENABLED=1
ORCH_PRESENTATION_COMPUTE_CONTROL_URL=http://127.0.0.1:30000
ORCH_PRESENTATION_COMPUTE_LEASE_MODE=in_place
ORCH_PRESENTATION_COMPUTE_TIMEOUT_MS=2000

# Complete cognitive model plan owned by this detected hardware profile.
# Do not override these keys in .env.local; create or update a profile instead.
AGENT_GOAL_INTERPRETER_MODEL=qwen3.5:4b
AGENT_COGNITIVE_GATEWAY_ATTENTION_MODEL=qwen3.5:4b
AGENT_GOAL_ASSOCIATION_MODEL=qwen3.5:4b
AGENT_FAST_PLANNER_MODEL=qwen3.5:4b
AGENT_DEEP_PLANNER_MODEL=qwen3.5:4b
AGENT_TASK_CONTINUITY_MODEL=qwen3.5:4b
AGENT_SKILL_SELECTION_MODEL=qwen3.5:4b
TTS_COSYVOICE_OLLAMA_MODEL=qwen3.5:4b

# Single-model cognition plan for the 16GB shared-GPU laptop. Every LLM role
# uses qwen3.5:4b. SGLang keeps one resident model while independently queued
# GI/GA/SC/Planner requests retain their own contexts and priority classes. The
# paired Compose bounds running requests to two; priority/preemption is a compute
# policy only and never changes semantic authority or Goal state.
TTS_COSYVOICE_COMPACT_COGNITION=0
TTS_COSYVOICE_OLLAMA_NUM_CTX=49152
OLLAMA_MAX_LOADED_MODELS=1
# These Ollama knobs remain only for the explicit fallback/baseline transport;
# the maintained SGLang service ignores them. The SGLang override separately owns
# its 49K context/cache budget and must be requalified with resident CosyVoice.
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# The qwen3.5 GI prompt and conservative budget check require more than 8K;
# complete Planner re-entry packets require up to 42172 estimated tokens including
# their unchanged output reservation and safety margin. Per-role request limits
# remain unchanged when transport moves to the shared 49K SGLang engine.
OLLAMA_CONTEXT_LENGTH=49152
OLLAMA_NUM_CTX=49152
AGENT_COGNITIVE_GATEWAY_ATTENTION_NUM_CTX=32768
AGENT_GOAL_INTERPRETER_LLM_NUM_CTX=16384
AGENT_GOAL_ASSOCIATION_NUM_CTX=32768
AGENT_FAST_PLANNER_NUM_CTX=49152
AGENT_DEEP_PLANNER_NUM_CTX=49152
AGENT_TASK_CONTINUITY_NUM_CTX=32768
AGENT_SKILL_SELECTION_NUM_CTX=32768
AGENT_LLM_PROMPT_CHARS_PER_TOKEN_ESTIMATE=2.0
AGENT_LLM_CONTEXT_SAFETY_MARGIN_TOKENS=2048

# Keep decoder-complete qualification budgets for the one resident model.
# These are output ceilings, not expected
# response lengths, and prevent the launcher-wide OLLAMA_NUM_PREDICT fallback
# from truncating structured planning or failure-response composition.
AGENT_COGNITIVE_GATEWAY_ATTENTION_NUM_PREDICT=256
AGENT_GOAL_INTERPRETER_LLM_NUM_PREDICT=512
AGENT_GOAL_ASSOCIATION_NUM_PREDICT=2048
AGENT_FAST_PLANNER_NUM_PREDICT=4096
# Full-catalog re-entry exceeds the old 32K reservation. Keep the full 4K
# output allowance and 2K safety margin inside the measured 48K topology.
AGENT_DEEP_PLANNER_NUM_PREDICT=4096
AGENT_TASK_CONTINUITY_NUM_PREDICT=2048

# Foreground latency policy is owned by env/modes/*.env; validation
# modes may override it with long watchdogs. Hardware profiles only size models.
OLLAMA_NUM_PREDICT=512
OLLAMA_TEMPERATURE=0.35
OLLAMA_TOP_P=0.9
# Retained only for explicit Ollama fallback comparisons; normal laptop startup
# uses SGLang and its Compose-owned max-running-request setting.
OLLAMA_NUM_PARALLEL=1

TTS_MODEL_SIZE=0.6B
# OuteTTS max_length includes the speaker/prompt tokens as well as generated
# audio-code tokens. 2048 can leave only enough generation headroom for the
# first words of an otherwise short sentence, so the maintained profile keeps
# the previously complete 4096-token window.
TTS_CONTEXT_SIZE=4096
TTS_MAX_LENGTH=4096
MIN_TTS_GENERATION_LENGTH=1024
TTS_MAX_TEXT_CHARS=200
TTS_N_BATCH=160
TTS_THREADS=6
