# RTX 4090 Laptop GPU profile (typically 16GB VRAM)
CHROMIE_HARDWARE_PROFILE=rtx4090_laptop
CHROMIE_ARCH=x86_64
CHROMIE_GPU_VENDOR=nvidia
CHROMIE_GPU_CLASS=laptop

TTS_CUDA_ARCH=89

ASR_MODEL=/root/.cache/huggingface/sherpa-onnx/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-int8-2024-07-17
ASR_MODEL_REVISION=asr-models/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-int8-2024-07-17

QWEN4B_SINGLE_MODEL=qwen3:4b-instruct-2507-q4_K_M
AGENT_MODEL=${QWEN4B_SINGLE_MODEL}
OLLAMA_MODEL=${QWEN4B_SINGLE_MODEL}

# Complete cognitive model plan owned by this detected hardware profile.
# Do not override these keys in .env.local; create or update a profile instead.
AGENT_GOAL_INTERPRETER_MODEL=${QWEN4B_SINGLE_MODEL}
AGENT_COGNITIVE_GATEWAY_ATTENTION_MODEL=${QWEN4B_SINGLE_MODEL}
AGENT_GOAL_ASSOCIATION_MODEL=${QWEN4B_SINGLE_MODEL}
AGENT_FAST_PLANNER_MODEL=${QWEN4B_SINGLE_MODEL}
AGENT_FAST_FIRST_RESPONSE_MODEL=${QWEN4B_SINGLE_MODEL}
AGENT_FAST_TRUTH_MODEL=${QWEN4B_SINGLE_MODEL}
AGENT_DEEP_PLANNER_MODEL=${QWEN4B_SINGLE_MODEL}
AGENT_TASK_CONTINUITY_MODEL=${QWEN4B_SINGLE_MODEL}
AGENT_SOCIAL_ATTENTION_MODEL=${QWEN4B_SINGLE_MODEL}
AGENT_SKILL_SELECTION_MODEL=${QWEN4B_SINGLE_MODEL}
TTS_COSYVOICE_OLLAMA_MODEL=${QWEN4B_SINGLE_MODEL}

# Single-model latency experiment. Keep one explicit non-thinking Qwen3 4B
# instruct runner resident and use it for every LLM cognition role. This tests
# whether runner swaps and lost provider KV/prefix state are the dominant source
# of conversational latency on the 16GB shared-GPU profile. Architecture roles
# remain separate; only their model assignment is collapsed. If a difficult
# case later proves that Fast cognition is insufficient, Deep can be moved back
# to a larger model from evidence rather than making every ordinary turn pay the
# model-switch cost.
TTS_COSYVOICE_COMPACT_COGNITION=1
TTS_COSYVOICE_OLLAMA_NUM_CTX=32768
OLLAMA_MAX_LOADED_MODELS=1

# Development/qualification context topology. Retained live evidence shows the
# staged Fast/Deep Planner and Response Composer requests can require more than
# 15K tokens after reserving output and safety headroom. Keep the server, warmup,
# and every cognitive stage on one 32K context to prevent pre-inference budget
# rejection and context-only Ollama runner replacement.
OLLAMA_CONTEXT_LENGTH=32768
OLLAMA_NUM_CTX=32768
AGENT_COGNITIVE_GATEWAY_ATTENTION_NUM_CTX=32768
AGENT_GOAL_INTERPRETER_LLM_NUM_CTX=32768
AGENT_GOAL_ASSOCIATION_NUM_CTX=32768
AGENT_FAST_PLANNER_NUM_CTX=32768
AGENT_DEEP_PLANNER_NUM_CTX=32768
AGENT_TASK_CONTINUITY_NUM_CTX=32768
AGENT_SOCIAL_ATTENTION_NUM_CTX=32768
AGENT_SKILL_SELECTION_NUM_CTX=32768
AGENT_LLM_PROMPT_CHARS_PER_TOKEN_ESTIMATE=2.0
AGENT_LLM_CONTEXT_SAFETY_MARGIN_TOKENS=2048

# Keep decoder-complete qualification budgets while using one resident model.
# These are output ceilings, not expected
# response lengths, and prevent the launcher-wide OLLAMA_NUM_PREDICT fallback
# from truncating structured planning or failure-response composition.
AGENT_COGNITIVE_GATEWAY_ATTENTION_NUM_PREDICT=256
AGENT_GOAL_INTERPRETER_LLM_NUM_PREDICT=2048
AGENT_GOAL_ASSOCIATION_NUM_PREDICT=2048
AGENT_FAST_PLANNER_NUM_PREDICT=4096
# The full-catalog prompt itself can exceed 24K estimated tokens. A 4K
# structured-output reserve plus the 2K safety margin fits the qualified 32K
# topology while retaining substantially more output than observed plans use.
AGENT_DEEP_PLANNER_NUM_PREDICT=4096
AGENT_TASK_CONTINUITY_NUM_PREDICT=2048

# Qualification-phase cognitive budgets.
# During architecture/workflow validation, correctness and complete model
# output take priority over response latency. Keep the Agent stage timeout at
# the contract maximum, give the host a larger envelope for HTTP/serialization
# overhead, and allow the complete staged pipeline to finish. Tune these down
# only after retained live evidence establishes warm p95/p99 latency.
CHROMIE_COGNITIVE_BUDGET_PROFILE=qualification
AGENT_COGNITIVE_GATEWAY_ATTENTION_TIMEOUT_MS=120000
AGENT_GOAL_INTERPRETER_TIMEOUT_MS=120000
AGENT_GOAL_ASSOCIATION_TIMEOUT_MS=120000
AGENT_FAST_PLANNER_TIMEOUT_MS=120000
AGENT_DEEP_PLANNER_TIMEOUT_MS=120000
AGENT_TASK_CONTINUITY_TIMEOUT_MS=120000
ORCH_GOAL_ASSOCIATION_TIMEOUT_MS=150000
ORCH_FAST_PLANNER_TIMEOUT_MS=150000
ORCH_DEEP_PLANNER_TIMEOUT_MS=150000
ORCH_TASK_CONTINUITY_TIMEOUT_MS=150000
ORCH_COGNITIVE_RUNTIME_TIMEOUT_MS=900000
OLLAMA_WARM_REQUEST_TIMEOUT_SECONDS=600
AGENT_TIMEOUT_MS=240000
ORCH_AGENT_TIMEOUT_MS=300000

OLLAMA_NUM_PREDICT=512
OLLAMA_TEMPERATURE=0.35
OLLAMA_TOP_P=0.9
OLLAMA_NUM_PARALLEL=1

TTS_MODEL_SIZE=0.6B
# OuteTTS max_length includes the speaker/prompt tokens as well as generated
# audio-code tokens. 2048 can leave only enough generation headroom for the
# first words of an otherwise short sentence, so the maintained profile keeps
# the previously complete 4096-token window.
TTS_CONTEXT_SIZE=4096
TTS_MAX_LENGTH=4096
MIN_TTS_GENERATION_LENGTH=1024
TTS_MAX_TEXT_CHARS=200
TTS_N_BATCH=160
TTS_THREADS=6
