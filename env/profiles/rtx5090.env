# RTX 5090 / Blackwell profile
CHROMIE_HARDWARE_PROFILE=rtx5090
CHROMIE_ARCH=x86_64
CHROMIE_GPU_VENDOR=nvidia
CHROMIE_GPU_CLASS=desktop

# Blackwell compute capability 12.0
TTS_CUDA_ARCH=120

ASR_MODEL=/root/.cache/huggingface/sherpa-onnx/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-int8-2024-07-17
ASR_MODEL_REVISION=asr-models/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-int8-2024-07-17

# Shared local reasoning model; the selected SGLang service owns model loading.
AGENT_MODEL=chromie-gemma4-12b
OLLAMA_MODEL=chromie-gemma4-12b

# SGLang serves the pinned Gemma checkpoint with online FP8 weights. The Compose
# owner retains the 64K context, bounded concurrency and priority scheduling.
AGENT_LLM_PROVIDER=sglang
AGENT_SGLANG_URL=http://chromie-llm:30000/v1
CHROMIE_COMPOSE_OVERRIDE_FILES=docker-compose.sglang.yml
WARM_OLLAMA_BEFORE_ORCH=0
ORCH_PRESENTATION_COMPUTE_LEASE_ENABLED=1
ORCH_PRESENTATION_COMPUTE_CONTROL_URL=http://127.0.0.1:30000
ORCH_PRESENTATION_COMPUTE_LEASE_MODE=in_place
ORCH_PRESENTATION_COMPUTE_TIMEOUT_MS=2000

# One shared Gemma4-12B model for every reasoning role. Each role retains its
# own prompt, context, schema, and semantic authority. ASR and TTS remain separate.
# This owner-requested topology is pending all-role qualification; model reuse
# alone does not establish semantic correctness or a provider performance win.
# Do not override these keys in .env.local; update this detected profile.
AGENT_GOAL_INTERPRETER_MODEL=chromie-gemma4-12b
AGENT_COGNITIVE_GATEWAY_ATTENTION_MODEL=chromie-gemma4-12b
AGENT_GOAL_ASSOCIATION_MODEL=chromie-gemma4-12b
AGENT_FAST_PLANNER_MODEL=chromie-gemma4-12b
AGENT_DEEP_PLANNER_MODEL=chromie-gemma4-12b
AGENT_TASK_CONTINUITY_MODEL=chromie-gemma4-12b
AGENT_SKILL_SELECTION_MODEL=chromie-gemma4-12b

# Keep CosyVoice on its specialized model with one resident cognition model.
TTS_COSYVOICE_COMPACT_COGNITION=0
TTS_COSYVOICE_OLLAMA_NUM_CTX=65536
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_REQUIRE_ALL_WARM_MODELS_RESIDENT=1
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# Use one 64K runner topology across roles to avoid reloading the same weights
# for different context sizes. Qualification controls precision separately.
OLLAMA_CONTEXT_LENGTH=65536
OLLAMA_NUM_CTX=65536
AGENT_COGNITIVE_GATEWAY_ATTENTION_NUM_CTX=65536
AGENT_GOAL_INTERPRETER_LLM_NUM_CTX=65536
AGENT_GOAL_ASSOCIATION_NUM_CTX=65536
AGENT_FAST_PLANNER_NUM_CTX=65536
AGENT_DEEP_PLANNER_NUM_CTX=65536
AGENT_TASK_CONTINUITY_NUM_CTX=65536
AGENT_SKILL_SELECTION_NUM_CTX=65536

# Reserve the complete output budget plus a margin before every request. The
# estimate is conservative enough for mixed Chinese/English prompts without
# treating the estimate as semantic evidence.
AGENT_LLM_PROMPT_CHARS_PER_TOKEN_ESTIMATE=2.0
AGENT_LLM_CONTEXT_SAFETY_MARGIN_TOKENS=2048

# Generous development/qualification output budgets. These are maxima; schema-
# constrained models may stop earlier. Tune down only after retained evidence
# proves the architecture and normal output distributions.
AGENT_COGNITIVE_GATEWAY_ATTENTION_NUM_PREDICT=256
AGENT_GOAL_INTERPRETER_LLM_NUM_PREDICT=2048
AGENT_GOAL_ASSOCIATION_NUM_PREDICT=2048
AGENT_FAST_PLANNER_NUM_PREDICT=4096
# The full-catalog prompt itself can exceed 24K estimated tokens. A 4K
# structured-output reserve plus the 2K safety margin fits the qualified 64K
# topology while retaining substantially more output than observed plans use.
AGENT_DEEP_PLANNER_NUM_PREDICT=4096
AGENT_TASK_CONTINUITY_NUM_PREDICT=2048

# Foreground latency policy is owned by env/modes/*.env; validation
# modes may override it with long watchdogs. Hardware profiles only size models.
OLLAMA_NUM_PREDICT=4096
OLLAMA_TEMPERATURE=0.35
OLLAMA_TOP_P=0.9
OLLAMA_KEEP_ALIVE=24h
OLLAMA_LOAD_TIMEOUT=10m

TTS_MODEL_SIZE=0.6B
TTS_CONTEXT_SIZE=8192
TTS_MAX_LENGTH=8192
# Keep cloned-speaker requests and retries independent. OuteTTS 0.4.4 mutates
# prompt state internally, and voice consistency is more important than the
# small prompt-cache latency gain on this profile.
TTS_RESET_LLAMA_STATE=1
MIN_TTS_GENERATION_LENGTH=1024
TTS_MAX_TEXT_CHARS=220
TTS_N_BATCH=256
TTS_THREADS=8
TTS_WORKER_COUNT=2
TTS_MAX_CONCURRENT_SYNTHESIS=2
