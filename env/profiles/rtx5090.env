# RTX 5090 / Blackwell profile
CHROMIE_HARDWARE_PROFILE=rtx5090
CHROMIE_ARCH=x86_64
CHROMIE_GPU_VENDOR=nvidia
CHROMIE_GPU_CLASS=desktop

# Blackwell compute capability 12.0
TTS_CUDA_ARCH=120

ASR_MODEL=/root/.cache/huggingface/sherpa-onnx/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-int8-2024-07-17
ASR_MODEL_REVISION=asr-models/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-int8-2024-07-17

# High-quality local talking brain. Use warm_ollama before orchestrator.
AGENT_MODEL=gemma4:12b
OLLAMA_MODEL=gemma4:12b

# Complete cognitive model plan owned by this detected hardware profile.
# Do not override these keys in .env.local; create or update a profile instead.
# Reuse the resident deliberate model for the one-call primary WHAT contract.
# Current source-bound live probes showed Qwen 3.5 9B copying transport identity,
# merging coordinated Chinese effects, and misusing semantic binding dimensions;
# Gemma 4 12B retained atomic outcomes, modalities, explicit values, and disjoint
# primary source evidence without adding another resident model.
AGENT_GOAL_INTERPRETER_MODEL=gemma4:12b
AGENT_COGNITIVE_GATEWAY_ATTENTION_MODEL=qwen3.5:9b
# Keep the deliberate model for the full Goal Association transaction. Retained
# cross-model evidence showed stronger independent responsibility auditing here;
# the DTO now exposes an explicit resource_kind token so constrained decoding no
# longer has to imply this semantic choice from null-versus-object structure.
AGENT_GOAL_ASSOCIATION_MODEL=gemma4:12b
AGENT_FAST_PLANNER_MODEL=qwen3.5:9b
# Keep the tiny natural-language and truth phases on the already-resident
# deliberate model. Exact retained 2026-08-25 replays showed Qwen 3.5 repeating
# valid JSON/Markdown until the 512-token bound and rejecting both false and exact
# completion claims; Gemma stopped in 47-72 tokens and distinguished those claims.
AGENT_DEEP_PLANNER_MODEL=gemma4:12b
AGENT_TASK_CONTINUITY_MODEL=qwen3.5:9b
# Social Attention must finish near its Primary Activity. Reuse the already-
# resident fast cognition model instead of loading a third model after speech
# starts; the exact behavior space remains bounded by its schema and live catalog.
AGENT_SKILL_SELECTION_MODEL=qwen3.5:9b

# Gemma 4 26B plus Qwen 4B and CosyVoice3 exhausted the 32GB GPU during live
# synthesis. Gemma 4 12B is the maintained multimodal-capable quality core: it
# preserves the two-model fast/deep topology while restoring enough VRAM
# headroom for CosyVoice. Camera observations are not wired into the runtime
# yet; this profile change prepares the model plan without claiming that the
# multimodal input contract is complete.
TTS_COSYVOICE_COMPACT_COGNITION=0
TTS_COSYVOICE_OLLAMA_NUM_CTX=32768
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_REQUIRE_ALL_WARM_MODELS_RESIDENT=1
# The 32GB profile can sustain the maintained Qwen3.5-9B + Gemma12B topology. Use
# Flash Attention and q8 KV to preserve additional VRAM headroom for CosyVoice
# and long contexts; warm_ollama resolves each model's actual role context.
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# Development/qualification context topology. Correctness and complete evidence
# take priority over latency while the architecture is still being finished.
# Keep every request for either resident model on the same 32K topology so
# Ollama does not create 2K/4K/8K runners for the same weights.
OLLAMA_CONTEXT_LENGTH=32768
OLLAMA_NUM_CTX=32768
AGENT_COGNITIVE_GATEWAY_ATTENTION_NUM_CTX=32768
AGENT_GOAL_INTERPRETER_LLM_NUM_CTX=32768
AGENT_GOAL_ASSOCIATION_NUM_CTX=32768
AGENT_FAST_PLANNER_NUM_CTX=32768
AGENT_DEEP_PLANNER_NUM_CTX=32768
AGENT_TASK_CONTINUITY_NUM_CTX=32768
# Every Qwen role in this two-model profile uses the same runner topology.
# The previous 4K Social Attention and 8K Skill Selection variants evicted/reloaded
# the 32K Fast runner between turns and were visible as multi-second load_duration.
AGENT_SKILL_SELECTION_NUM_CTX=32768

# Reserve the complete output budget plus a margin before every request. The
# estimate is conservative enough for mixed Chinese/English prompts without
# treating the estimate as semantic evidence.
AGENT_LLM_PROMPT_CHARS_PER_TOKEN_ESTIMATE=2.0
AGENT_LLM_CONTEXT_SAFETY_MARGIN_TOKENS=2048

# Generous development/qualification output budgets. These are maxima; schema-
# constrained models may stop earlier. Tune down only after retained evidence
# proves the architecture and normal output distributions.
AGENT_COGNITIVE_GATEWAY_ATTENTION_NUM_PREDICT=256
AGENT_GOAL_INTERPRETER_LLM_NUM_PREDICT=2048
AGENT_GOAL_ASSOCIATION_NUM_PREDICT=2048
AGENT_FAST_PLANNER_NUM_PREDICT=4096
# The full-catalog prompt itself can exceed 24K estimated tokens. A 4K
# structured-output reserve plus the 2K safety margin fits the qualified 32K
# topology while retaining substantially more output than observed plans use.
AGENT_DEEP_PLANNER_NUM_PREDICT=4096
AGENT_TASK_CONTINUITY_NUM_PREDICT=2048

# Foreground latency policy is owned by env/modes/*.env; validation
# modes may override it with long watchdogs. Hardware profiles only size models.
OLLAMA_NUM_PREDICT=4096
OLLAMA_TEMPERATURE=0.35
OLLAMA_TOP_P=0.9
OLLAMA_KEEP_ALIVE=24h
OLLAMA_LOAD_TIMEOUT=10m

TTS_MODEL_SIZE=0.6B
TTS_CONTEXT_SIZE=8192
TTS_MAX_LENGTH=8192
# Keep cloned-speaker requests and retries independent. OuteTTS 0.4.4 mutates
# prompt state internally, and voice consistency is more important than the
# small prompt-cache latency gain on this profile.
TTS_RESET_LLAMA_STATE=1
MIN_TTS_GENERATION_LENGTH=1024
TTS_MAX_TEXT_CHARS=220
TTS_N_BATCH=256
TTS_THREADS=8
TTS_WORKER_COUNT=2
TTS_MAX_CONCURRENT_SYNTHESIS=2
