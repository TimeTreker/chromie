# Opt-in validation overlay for the qualified single-engine SGLang candidate.
# This is scheduler/runtime and semantic qualification input, not model-role promotion.
AGENT_LLM_PROVIDER=sglang
AGENT_SGLANG_URL=http://chromie-llm-sglang-qualification:30000/v1
AGENT_SGLANG_PRIORITY_STEP=100

# The qualified SGLang engine serves one exact Qwen3.5-9B name. Every Agent role
# must therefore address that served model during this candidate run. Passing this
# overlay does not change the maintained RTX 5090 Ollama role topology.
AGENT_MODEL=chromie-qwen35-9b-sglang
AGENT_GOAL_INTERPRETER_MODEL=chromie-qwen35-9b-sglang
AGENT_COGNITIVE_GATEWAY_ATTENTION_MODEL=chromie-qwen35-9b-sglang
AGENT_GOAL_ASSOCIATION_MODEL=chromie-qwen35-9b-sglang
AGENT_FAST_PLANNER_MODEL=chromie-qwen35-9b-sglang
AGENT_DEEP_PLANNER_MODEL=chromie-qwen35-9b-sglang
AGENT_TASK_CONTINUITY_MODEL=chromie-qwen35-9b-sglang
AGENT_SKILL_SELECTION_MODEL=chromie-qwen35-9b-sglang

# SGLang owns the live model runtime for this validation overlay; do not warm or
# start Ollama merely to satisfy a historical launcher assumption.
WARM_OLLAMA_BEFORE_ORCH=0
TTS_COSYVOICE_COMPACT_COGNITION=0

# Provider-level protocol-5 evidence qualified this exact Host resource primitive.
# The Host owns when speech may borrow the shared GPU; SGLang only executes the
# pause/resume command and never owns presentation semantics.
ORCH_PRESENTATION_COMPUTE_LEASE_ENABLED=1
ORCH_PRESENTATION_COMPUTE_CONTROL_URL=http://127.0.0.1:30000
ORCH_PRESENTATION_COMPUTE_LEASE_MODE=in_place
ORCH_PRESENTATION_COMPUTE_TIMEOUT_MS=2000
