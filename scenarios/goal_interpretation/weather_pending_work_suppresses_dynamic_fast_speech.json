{
  "schema_version": 1,
  "id": "weather_pending_work_suppresses_dynamic_fast_speech",
  "suite": "goal_interpretation",
  "level": "integration",
  "description": "A weather lookup suppresses model-authored dynamic speech before trusted evidence exists, even when pending-work repair is enabled; the Host cache remains a separate generic latency path.",
  "tags": [
    "reported-live-voice",
    "weather",
    "evidence-before-claim",
    "pending-work",
    "zh-CN"
  ],
  "input": {
    "text": "今天北京下雨了没有？",
    "language": "zh-CN"
  },
  "stub": {
    "interpretation_mode": "hybrid",
    "pending_work_fast_speech_repair_enabled": true,
    "catalog": {
      "catalog_version": 81,
      "capabilities": [
        {
          "capability_id": "chromie.weather.lookup",
          "agent_id": "chromie.tool",
          "description": "Retrieve current weather or forecast for a supplied place and date.",
          "route": "tool",
          "prompt_tier": "common",
          "available": true,
          "interaction_executable": true,
          "effects": [
            "read_only",
            "weather_lookup"
          ],
          "safety_class": "safe_read",
          "requires_confirmation": false
        }
      ]
    },
    "llm_script": [
      {
        "stage": "quick_intent",
        "decision": {
          "route": "tool",
          "intent": "capability:chromie.weather.lookup",
          "confidence": 0.95,
          "language": "zh-CN",
          "metadata": {
            "tool_name": "weather",
            "weather_query": {
              "location": "北京",
              "date": "today",
              "units": "metric"
            }
          }
        }
      }
    ]
  },
  "expect": {
    "route": "tool",
    "intent": "capability:chromie.weather.lookup",
    "source": "llm",
    "llm_calls": 1,
    "llm_stages": [
      "quick_intent"
    ],
    "fast_speech_present": false,
    "metadata_json_contains": [
      "tool_evidence_required_before_dynamic_speech"
    ],
    "task_types_include": [
      "task.use_tool"
    ]
  }
}
