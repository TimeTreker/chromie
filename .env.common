# Local-development image aliases. These mutable defaults are convenient for
# local Compose builds but are intentionally rejected by publishable release
# provenance, which requires resolved image and Ollama model digests.
CHROMIE_IMAGE_TAG=latest
PYTHON_IMAGE=python:3.12.10-slim-bookworm
OLLAMA_IMAGE=ollama/ollama:latest

# Chromie common environment
# Hardware-specific values are in env/profiles/*.env.
# User-local overrides go in .env.local.
# Generated runtime environment goes to .env.runtime.

COMPOSE_PROJECT_NAME=chromie

# Optional proxy for container model downloads. Leave blank if unused.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,host.docker.internal,chromie-asr,chromie-tts,chromie-llm,chromie-agent

# Common container/GPU visibility defaults.
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Hugging Face cache/offline mode.
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# ASR backend defaults. Current supported mode is final utterance only.
ASR_BACKEND=sherpa_onnx
ASR_MODE=final

# Default sherpa-onnx ASR backend. Faster-Whisper remains installed/selectable.
SHERPA_ONNX_MODEL_TYPE=sense_voice
SHERPA_ONNX_PROVIDER=cuda
SHERPA_ONNX_NUM_THREADS=2
SHERPA_ONNX_LANGUAGE=auto
SHERPA_ONNX_USE_ITN=true
SHERPA_ONNX_DEBUG=false
SHERPA_ONNX_MODEL_FILE=
SHERPA_ONNX_TOKENS_FILE=

# Goal Interpretation: use a small fast model for semantic understanding; safety interrupts remain deterministic.
AGENT_GOAL_INTERPRETER_MODEL=qwen3.5:4b

# Focused pre-Core addressedness review. It may only admit or suppress;
# route, intent, goal, capability, action, and planning remain Core-owned.
AGENT_COGNITIVE_GATEWAY_ATTENTION_ENABLED=1
AGENT_COGNITIVE_GATEWAY_ATTENTION_MODEL=qwen3:4b
AGENT_COGNITIVE_GATEWAY_ATTENTION_TIMEOUT_MS=2500
AGENT_COGNITIVE_GATEWAY_ATTENTION_MIN_SUPPRESSION_CONFIDENCE=0.72
AGENT_COGNITIVE_GATEWAY_ATTENTION_NUM_CTX=2048
AGENT_COGNITIVE_GATEWAY_ATTENTION_NUM_PREDICT=96
# Shared capability catalog served by the Agent service.
 # Capability applicability is declared by typed catalog contracts; no semantic route taxonomy is used.

# Maintained default TTS backend. The source-controlled voice catalog contains
# chromie_zh, chromie_en, and chromie_mixed; default requests route by language.
CHROMIE_TTS_BACKEND=cosyvoice3
TTS_PROVIDER=fun-cosyvoice3-0.5b
TTS_VOICE_ROOT=assets/tts/voices
TTS_DEFAULT_SPEAKER=chromie_mixed
TTS_TOKENIZER_REPO=OuteAI/OuteTTS-1.0-0.6B
TTS_TOKENIZER_REVISION=e7bcd87b0ca47fd8c46317c8f745a5e4e19c7b5c
TTS_GGUF_REPO=OuteAI/OuteTTS-1.0-0.6B-GGUF
TTS_GGUF_REVISION=d85d0f1e5242c3fb04c95f55bd99ec3ebd4c2d16
TTS_SPEAKER_ALIGNMENT_DEVICE=cpu
TTS_SPEAKER_TRANSCRIPT_MIN_SIMILARITY=0.75

# Maintained CosyVoice3 model locks and optional comparison backends.
COSYVOICE3_SOURCE_REVISION=074ca6dc9e80a2f424f1f74b48bdd7d3fea531cc
COSYVOICE3_MODEL_ID=FunAudioLLM/Fun-CosyVoice3-0.5B-2512
COSYVOICE3_MODEL_REVISION=29e01c4e8d000f4bcd70751be16fa94bf3d85a18
# CosyVoice shares the GPU with cognition. Constrained profiles may explicitly
# choose one compact resident model; maintained RTX 4090 Laptop and RTX 5090
# profiles preserve a fast/quality split with profile-sized quality models.
TTS_COSYVOICE_OLLAMA_MODEL=qwen3:4b
TTS_COSYVOICE_COMPACT_COGNITION=1
QWEN3_TTS_SOURCE_REVISION=022e286b98fbec7e1e916cb940cdf532cd9f488e
QWEN3_TTS_MODEL_ID=Qwen/Qwen3-TTS-12Hz-0.6B-Base
QWEN3_TTS_MODEL_REVISION=5d83992436eae1d760afd27aff78a71d676296fc
AGENT_GOAL_INTERPRETER_TIMEOUT_MS=5400
AGENT_GOAL_INTERPRETER_LLM_NUM_CTX=16384
AGENT_GOAL_INTERPRETER_LLM_NUM_PREDICT=512
AGENT_GOAL_INTERPRETER_LLM_KEEP_ALIVE=24h
AGENT_GOAL_INTERPRETER_WARM_LLM_ON_STARTUP=1
AGENT_GOAL_INTERPRETER_WARM_LLM_TIMEOUT_MS=60000

# Agent: the real talking brain.
AGENT_USE_LLM=1
AGENT_ENABLE_READ_ONLY_DAG_EXECUTION=0
AGENT_ENABLE_PLANNING_DAG_EXECUTION=0
AGENT_ENABLE_PARALLEL_DAG_EXECUTION=0
AGENT_DAG_ENGINE_MAX_CONCURRENCY=4
AGENT_ENABLE_GUARDED_DAG_EXECUTION=0
AGENT_ENABLE_PHYSICAL_DAG_EXECUTION=0
# Owner-editable robot identity, mind principles, and social style. Code owns only
# the schema and validation; concrete identity values live in this JSON profile.
ORCH_MIND_PROFILE_PATH=config/mind/chromie_default.json
ORCH_SOCIAL_INTERACTION_STYLE_PRESET=courteous
AGENT_DAG_ENGINE_EXECUTION_TOKEN=
AGENT_DAG_ENGINE_DIAGNOSTICS_TOKEN=
AGENT_DAG_ENGINE_TRACE_MAX_ENTRIES=128
AGENT_DAG_ENGINE_TRACE_TTL_SEC=900
AGENT_DAG_ENGINE_GRANT_MAX_ENTRIES=128
# Comma-separated files/directories. Docker Compose supplies the Agent
# container's mounted Soridormi manifest by default; host-side imports keep this
# empty unless a caller explicitly opts in.
AGENT_CAPABILITY_MANIFESTS=
AGENT_SKILL_ROOTS=agent-skills
# Model-authored Agent Skill selection is an optional cognitive advisory boundary.
# It receives bounded approved summaries only and does not load projections,
# mutate Plans, register Capabilities, or execute package content.
AGENT_SKILL_SELECTION_ENABLED=1
AGENT_SKILL_SELECTION_MODEL=qwen3:4b
AGENT_SKILL_SELECTION_TIMEOUT_MS=10000
AGENT_SKILL_SELECTION_MAX_CANDIDATES=12
AGENT_SKILL_SELECTION_MAX_SELECTED=4
AGENT_SKILL_SELECTION_MIN_CONFIDENCE=0.55
AGENT_SKILL_SELECTION_NUM_CTX=8192
AGENT_SKILL_SELECTION_NUM_PREDICT=512
AGENT_SKILL_PROGRESSIVE_DISCLOSURE_ENABLED=1
AGENT_SKILL_PROJECTION_MAX_CHARS=3000
AGENT_SKILL_PROJECTION_TOTAL_MAX_CHARS=6000
AGENT_SKILL_PROJECTION_COUNT_LIMIT=4
SORIDORMI_MCP_URL=
AGENT_CAPABILITY_CATALOG_REFRESH_SEC=30
AGENT_CAPABILITY_MATCH_LIMIT=8
AGENT_CAPABILITY_PROMPT_TIER_PRESET=capabilities/prompt_tiers.json
AGENT_CAPABILITY_PROMPT_TIER_OVERRIDES=
# Optional provider-neutral read-only adapter for grounded web facts,
# recommendations, places, restaurants, news, and how-to research. The
# provider returns Evidence; Fast Planner uses trusted Evidence to author any
# user-facing result Communicative Activity.
AGENT_EXTERNAL_INFORMATION_ENABLED=0
AGENT_EXTERNAL_INFORMATION_URL=
AGENT_EXTERNAL_INFORMATION_TOKEN=
AGENT_EXTERNAL_INFORMATION_TIMEOUT_MS=15000
AGENT_GOAL_ASSOCIATION_ENABLED=1
AGENT_GOAL_ASSOCIATION_MODEL=qwen3:4b
AGENT_GOAL_ASSOCIATION_TIMEOUT_MS=3000
AGENT_GOAL_ASSOCIATION_MIN_CONFIDENCE=0.65
AGENT_GOAL_ASSOCIATION_MAX_ACTIVE_GOALS=8
AGENT_GOAL_ASSOCIATION_NUM_CTX=4096
AGENT_GOAL_ASSOCIATION_NUM_PREDICT=512
AGENT_FAST_PLANNER_ENABLED=1
AGENT_FAST_PLANNER_MODEL=qwen3:4b
AGENT_FAST_PLANNER_TIMEOUT_MS=2500
AGENT_FAST_FIRST_RESPONSE_TIMEOUT_MS=2500
AGENT_FAST_PLANNER_NUM_CTX=8192
AGENT_FAST_PLANNER_NUM_PREDICT=2048
AGENT_FAST_PLANNER_MAX_CAPABILITIES=24
AGENT_DEEP_PLANNER_ENABLED=1
AGENT_DEEP_PLANNER_MODEL=gemma4:e2b
AGENT_DEEP_PLANNER_TIMEOUT_MS=9000
AGENT_DEEP_PLANNER_MIN_GOAL_SATISFACTION=0.75
AGENT_DEEP_PLANNER_NUM_CTX=8192
AGENT_DEEP_PLANNER_NUM_PREDICT=1024
AGENT_DEEP_PLANNER_MAX_CAPABILITIES=96

# Short-term conversation state.
# SID is still one VAD utterance. conversation_id spans multiple turns.
ORCH_ENABLE_CONVERSATION_STATE=1
ORCH_CONVERSATION_ID=local_default
ORCH_CONVERSATION_MAX_TURNS=12
ORCH_CONVERSATION_IDLE_TIMEOUT_SEC=180
ORCH_CONVERSATION_HARD_IDLE_TIMEOUT_SEC=900
ORCH_CONVERSATION_TURN_MAX_TEXT_CHARS=260
ORCH_CONVERSATION_MAX_CONTEXT_CHARS=2200
ORCH_CONVERSATION_MAX_PENDING_TASKS=8
# Optional explicit whole-utterance reset commands use | as separator.
# ORCH_CONVERSATION_RESET_PHRASES=new topic|start over|换个话题|重新开始
ORCH_ENABLE_EPISODE_RECORDING=1
ORCH_EPISODE_LOG_PATH=.chromie/experience/episodes.jsonl
ORCH_EPISODE_MAX_TURNS=12

# Ollama common behavior.
OLLAMA_KEEP_ALIVE=24h
OLLAMA_LOAD_TIMEOUT=10m
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_NUM_PARALLEL=1
OLLAMA_WARM_TIMEOUT_SECONDS=600
OLLAMA_WARM_REQUEST_TIMEOUT_SECONDS=300
OLLAMA_WARM_NUM_PREDICT=1
# Conservative request preflight. Before sending a request, Chromie estimates
# prompt tokens, reserves the requested output budget and a safety margin, and
# fails closed when the declared context cannot hold the complete request.
AGENT_LLM_PROMPT_CHARS_PER_TOKEN_ESTIMATE=2.0
AGENT_LLM_CONTEXT_SAFETY_MARGIN_TOKENS=512
# The rare host direct-LLM fallback buffers the complete response and verifies
# completion diagnostics before scheduling any TTS. This prevents a truncated
# stream from becoming audible partial speech.
ORCH_DIRECT_LLM_REQUIRE_COMPLETE_OUTPUT=1
OLLAMA_AUTO_RESTART_ON_CRASH=1
WARM_OLLAMA_BEFORE_ORCH=1

# TTS stability defaults.
TTS_MAX_CONCURRENT_SYNTHESIS=1
TTS_GENERATION_RETRIES=1
TTS_RESET_LLAMA_STATE=0
TTS_AUDIO_CODEC_DEVICE=auto
TTS_DETAILED_TIMING=1
TTS_METRICS_WINDOW=20
GGML_CUDA_DISABLE_GRAPHS=0
TTS_WORKER_STARTUP_TIMEOUT_SEC=1200
# Prime every committed CosyVoice language/reference path before microphone input.
TTS_COSYVOICE_WARMUP_TIMEOUT_SEC=300
TTS_COSYVOICE_ZH_WARMUP_TEXT=你好。
TTS_COSYVOICE_EN_WARMUP_TEXT=Hello.
TTS_COSYVOICE_MIXED_WARMUP_TEXT=你好，Hello.
# Candidate providers first discard a nearly-complete cancelled request while
# holding their singleton worker lock, then restart fail-closed on timeout.
TTS_CANDIDATE_CANCEL_DRAIN_TIMEOUT_SEC=3
# Native candidate workers must not leave a WebSocket request hanging when an
# internal inference thread dies or stops producing stream events. A newly
# started worker gets one wider cold-synthesis envelope for CUDA kernel, speaker
# conditioning, and frontend cache initialization. After its first successful
# completion, the tighter steady-state watchdogs apply.
TTS_CANDIDATE_COLD_FIRST_AUDIO_TIMEOUT_SEC=180
TTS_CANDIDATE_COLD_REQUEST_TIMEOUT_SEC=240
TTS_CANDIDATE_FIRST_AUDIO_TIMEOUT_SEC=20
TTS_CANDIDATE_REQUEST_TIMEOUT_SEC=60
# Reduce CUDA allocator fragmentation. This is defensive headroom, not a
# substitute for a profile whose resident models actually fit in VRAM.
TTS_PYTORCH_ALLOC_CONF=expandable_segments:True
TTS_TEMPERATURE=0.4
TTS_REPETITION_PENALTY=1.1
TTS_MIN_TEXT_CHARS=1
TTS_MAX_TEXT_CHARS=220
TTS_SAMPLE_RATE=44100
TTS_CHUNK_MS=120
TTS_WORKER_COUNT=1

# Orchestrator behavior.
ORCH_ENABLE_AGENT=1
ORCH_AGENT_GOAL_INTERPRETER_TIMEOUT_MS=9000
ORCH_ENABLE_INTERACTION_RESPONSE=1
ORCH_ENABLE_SORIDORMI_CAPABILITIES=0
# Play only fully structured, non-terminal Core-authored process speech.
# Startup-primed cached acknowledgements use a hedge timer and avoid realtime TTS generation.
# Reject long or semantically incorrect cached cues before they can be played.
# Treat ignored ambient turns as non-engagement; recent accepted turns and active
# tasks keep natural follow-ups open for this bounded interval.
ORCH_ADDRESSEDNESS_GATE_ENABLED=1
ORCH_ADDRESSEDNESS_ENGAGEMENT_TIMEOUT_SEC=45
# Schedule only a validated Fast Planner Communicative Activity when useful.
# Goal Association/Fast/Deep standalone modes are diagnostic observers only;
# the maintained semantic authority remains the unified apply runtime.
ORCH_GOAL_ASSOCIATION_MODE=off
ORCH_GOAL_ASSOCIATION_TIMEOUT_MS=3500
ORCH_FAST_PLANNER_MODE=off
ORCH_FAST_PLANNER_TIMEOUT_MS=3000
ORCH_DEEP_PLANNER_MODE=off
ORCH_DEEP_PLANNER_TIMEOUT_MS=10000
# Unified goal-driven runtime is the semantic authority for maintained interactions.
# Capability eligibility comes from typed Goal/Capability contracts, not semantic lanes.
# Once it starts, failures are fail-closed; there is no alternate semantic planner fallback.
ORCH_COGNITIVE_RUNTIME_MODE=apply
ORCH_COGNITIVE_RUNTIME_TIMEOUT_MS=15000
ORCH_COGNITIVE_EVIDENCE_ENABLED=1
ORCH_COGNITIVE_EVIDENCE_INCLUDE_TEXT=0
ORCH_COGNITIVE_EVIDENCE_PATH=.chromie/evidence/cognitive-runtime/events.jsonl
# Optional digest-bound identity captured for source-bound qualification. Missing is
# allowed in ordinary development but cannot satisfy target-evidence gates.
ORCH_COGNITIVE_RUN_IDENTITY_PATH=.chromie/evidence/runtime-identity.json
ORCH_CONFIRMATION_TTL_SEC=20
ORCH_CAPABILITY_MAX_CONCURRENCY=8
AGENT_URL=http://127.0.0.1:8092
ACTION_EXECUTOR_URL=http://127.0.0.1:8095
ORCH_AGENT_TIMEOUT_MS=9000
ORCH_ASR_TIMEOUT_MS=30000
ORCH_ACTION_TIMEOUT_MS=5000
TTS_FLUSH_CHARS=80
ORCH_TTS_CONCURRENCY=1
ORCH_TTS_TEXT_CHUNKING=true
ORCH_TTS_FIRST_CHUNK_CHARS=16
ORCH_TTS_CHUNK_CHARS=120
ORCH_TTS_MIN_CHUNK_CHARS=20
ORCH_TTS_CJK_CHUNK_CHARS=36
ORCH_TTS_CJK_MIN_CHUNK_CHARS=8
ORCH_TTS_PLAYBACK_START_TIMEOUT_MS=3500
# After all services are healthy, perform one quiet, untargeted, capability-
# grounded startup orientation before opening the live microphone. This is
# baseline lifecycle Activity/liveliness, not Social Attention because no social
# interaction anchor exists yet. Startup speech is a separate operator opt-in.
ORCH_RUNTIME_READY_GREETING_ENABLED=1
ORCH_RUNTIME_READY_GREETING_SPEECH_ENABLED=0
ORCH_RUNTIME_READY_GREETING_TEXT=
ORCH_RUNTIME_READY_GREETING_FALLBACK_TEXT=
ORCH_RUNTIME_READY_GREETING_LANGUAGE=zh-CN
ORCH_RUNTIME_READY_GREETING_MODEL=
ORCH_RUNTIME_READY_GREETING_NUM_PREDICT=32
ORCH_RUNTIME_READY_GREETING_GENERATION_TIMEOUT_MS=15000
ORCH_RUNTIME_READY_GREETING_TIMEOUT_MS=45000
ORCH_ACTION_DRY_RUN=true
ORCH_SORIDORMI_MANIFEST=capabilities/soridormi.json
ORCH_SAVE_AUDIO=false

# Logging.
LOG_LEVEL=INFO

# Default CUDA images for desktop NVIDIA builds.
# Jetson/ARM64 container images may need a later docker-compose.jetson.yml and Jetson-specific Dockerfiles.
ASR_CUDA_IMAGE=nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04
TTS_CUDA_IMAGE=nvidia/cuda:12.8.1-devel-ubuntu24.04

# ASR defaults; hardware profiles override model/compute type.
ASR_DEVICE=cuda
ASR_LANGUAGE=
ASR_BEAM_SIZE=1
ASR_VAD_FILTER=false
ASR_CONDITION_ON_PREVIOUS_TEXT=false
ASR_MAX_CONCURRENT_TRANSCRIPTIONS=1
ASR_STARTUP_WARMUP_ENABLED=true
ASR_STARTUP_WARMUP_AUDIO_SECONDS=1.0

# TTS defaults; hardware profiles override size/context/batch/thread values.
TTS_QUANTIZATION=FP16
TTS_N_GPU_LAYERS=-1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Optional structured Orchestrator event evidence (may contain private speech).
ORCH_EVENT_LOG_PATH=
