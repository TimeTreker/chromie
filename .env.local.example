# Chromie local overrides
# Copy to .env.local and edit. This file is intentionally not used directly.
# .env.local should not be committed.

# Hardware detection and the cognitive model plan are automatic.
# Do not set CHROMIE_HARDWARE_PROFILE or any profile-owned *_MODEL key here.
# Stale profile-owned entries are ignored with warnings; CHROMIE_ENV_STRICT=1
# turns those warnings into generation errors for CI/configuration cleanup.
# Update env/profiles/<detected-profile>.env when a hardware-class plan must change.

# Machine-local paths and non-profile rollout settings remain valid here.

# Mind profile selection is automatic: .chromie/mind/active_profile.json (written
# by scripts/configure_chromie_mind.py) when present, otherwise the factory
# profile config/mind/chromie_default.json. Set this only to force another
# complete MindProfile JSON (relative paths resolve from the repository root).
# ORCH_MIND_PROFILE_PATH=config/mind/chromie_default.json

# Optional owner/operator Social Interaction Style override. When unset, the
# selected Mind profile's own social style is used. This affects only
# model-facing courtesy/expression tendencies; it never changes provider safety.
# Values: courteous, neutral, reserved. Use a full ORCH_MIND_PROFILE_PATH JSON
# profile with preset=custom for reviewed custom guidance.
# ORCH_SOCIAL_INTERACTION_STYLE_PRESET=courteous

# CosyVoice3 is the maintained default. Its built-in Git-controlled catalog is:
# TTS_VOICE_ROOT=assets/tts/voices
# TTS_DEFAULT_SPEAKER=chromie_mixed
# Override TTS_VOICE_ROOT only with another complete validated catalog.
# CHROMIE_TTS_BACKEND=oute   # explicit low-resource fallback
# CHROMIE_TTS_BACKEND=qwen3  # explicit alternative
# OLLAMA_DATA_DIR=/home/chromie/Models/ollama_data
# Agent capability-catalog overrides. Per-role model, context, output and
# timeout budgets are owned by the hardware profile and operator mode.
# User Meaning Interpretation remains WHAT-only and does not query this catalog
# to select executable capabilities.
# AGENT_CAPABILITY_CATALOG_REFRESH_SEC=30
# AGENT_CAPABILITY_MATCH_LIMIT=8
# AGENT_GOAL_ASSOCIATION_ENABLED=1
# AGENT_GOAL_ASSOCIATION_MIN_CONFIDENCE=0.65
# AGENT_GOAL_ASSOCIATION_MAX_ACTIVE_GOALS=8
# AGENT_FAST_PLANNER_ENABLED=1
# AGENT_FAST_PLANNER_MAX_CAPABILITIES=24
# AGENT_DELIBERATIVE_ENABLED=1

# External capability manifests mounted from ./capabilities into the Agent.
# AGENT_CAPABILITY_MANIFESTS=/app/capabilities/soridormi.json
# AGENT_EXTERNAL_INFORMATION_ENABLED=1
# AGENT_EXTERNAL_INFORMATION_URL=http://host.docker.internal:8110/retrieve
# AGENT_EXTERNAL_INFORMATION_TOKEN=replace-with-provider-token
# AGENT_EXTERNAL_INFORMATION_TIMEOUT_MS=15000

# Explicit owner-approved Agent Skill roots. Compose mounts the repository root
# read-only at /app/agent-skills. This does not enable model selection.
# AGENT_SKILL_ROOTS=/app/agent-skills
# AGENT_SKILL_SELECTION_ENABLED=1
# AGENT_SKILL_SELECTION_TIMEOUT_MS=10000
# AGENT_SKILL_SELECTION_MAX_CANDIDATES=12
# AGENT_SKILL_SELECTION_MAX_SELECTED=4
# AGENT_SKILL_SELECTION_MIN_CONFIDENCE=0.55
# AGENT_SKILL_SELECTION_NUM_PREDICT=512
# AGENT_SKILL_PROGRESSIVE_DISCLOSURE_ENABLED=1
# AGENT_SKILL_PROJECTION_MAX_CHARS=3000
# AGENT_SKILL_PROJECTION_TOTAL_MAX_CHARS=6000
# AGENT_SKILL_PROJECTION_COUNT_LIMIT=4
# AGENT_ENABLE_READ_ONLY_DAG_EXECUTION=1
# Stateful plan creation has its own non-physical execution gate.
# AGENT_ENABLE_PLANNING_DAG_EXECUTION=1
# Independent read/planning nodes may run concurrently. Default remains off.
# AGENT_ENABLE_PARALLEL_DAG_EXECUTION=1
# AGENT_DAG_ENGINE_MAX_CONCURRENCY=4
# Supervised side effects require both a bearer token and this enable flag.
# AGENT_ENABLE_GUARDED_DAG_EXECUTION=1
# AGENT_DAG_ENGINE_EXECUTION_TOKEN=replace-with-a-long-random-secret
# Physical motion has a separate opt-in.
# AGENT_ENABLE_PHYSICAL_DAG_EXECUTION=1

# Operator modes own the interaction/Soridormi enable flags and the Cognitive
# Runtime mode/timeouts; choose a launcher instead of overriding them here.
# SORIDORMI_MCP_URL=http://127.0.0.1:8000/mcp
# ORCH_SORIDORMI_MANIFEST=capabilities/soridormi.json
# The provider catalog declares each named skill's ordinary confirmation requirement.
# Permit semantic ambient-speech ignore only while no accepted turn or active
# task keeps the interaction engaged.
# ORCH_ADDRESSEDNESS_GATE_ENABLED=1
# ORCH_ADDRESSEDNESS_ENGAGEMENT_TIMEOUT_SEC=45
# Standalone Goal Association/Fast/Deep modes are diagnostic observers only;
# they are not a fallback semantic pipeline.
# ORCH_GOAL_ASSOCIATION_MODE=off
# ORCH_FAST_PLANNER_MODE=off
# ORCH_TTS_CJK_CHUNK_CHARS=36
# ORCH_TTS_CJK_MIN_CHUNK_CHARS=8
# The default provider identity is fun-cosyvoice3-0.5b. Use the launcher
# --tts-backend option for an explicit Oute or Qwen3 fallback.
# TTS_PROVIDER=fun-cosyvoice3-0.5b
# OuteTTS v3 speaker creation aligns the exact supplied transcript on CPU by
# default, rejects materially different recognized content, and rejects
# profiles whose DAC acoustic codes do not cover the reference recording.
# Select an installation-local profile only after its multilingual gate passes.
# TTS_SPEAKER_ID=chromie_mixed
# TTS_SPEAKER_ALIGNMENT_DEVICE=cpu
# TTS_SPEAKER_TRANSCRIPT_MIN_SIMILARITY=0.75
# Optional alternative-provider overrides; keep revisions immutable.
# COSYVOICE3_MODEL_REVISION=<hugging-face-commit>
# QWEN3_TTS_MODEL_REVISION=<hugging-face-commit>
# TTS_AUDIO_CODEC_DEVICE=auto
# TTS_DETAILED_TIMING=1
# TTS_METRICS_WINDOW=20
# GGML_CUDA_DISABLE_GRAPHS=0
# Spoken approvals expire and are single-use.
# ORCH_CONFIRMATION_TTL_SEC=20
# ORCH_CAPABILITY_MAX_CONCURRENCY=8

# Conversation state overrides.
# ORCH_ENABLE_CONVERSATION_STATE=1
# ORCH_CONVERSATION_IDLE_TIMEOUT_SEC=180
# ORCH_CONVERSATION_HARD_IDLE_TIMEOUT_SEC=900
# ORCH_CONVERSATION_MAX_TURNS=12
# ORCH_CONVERSATION_MAX_CONTEXT_CHARS=2200
# ORCH_ENABLE_EPISODE_RECORDING=1
# ORCH_EPISODE_LOG_PATH=.chromie/experience/episodes.jsonl
# ORCH_EPISODE_MAX_TURNS=12
# Optional versioned Data Loop policy. Copy the maintained example, review its
# privacy/retention fields, enable it explicitly, and configure the existing
# Runtime Event/trigger roots before selecting the copy here.
# ORCH_DATA_LOOP_INTERACTION_SESSION_CAPTURE_POLICY_PATH=config/data_loop/interaction_session_capture.local.json
# CHROMIE_RUNTIME_EVENT_ROOT=.chromie/runtime-events
# CHROMIE_DATA_LOOP_TRIGGER_ROOT=.chromie/data-loop-inbox

# For conda-based host orchestrator.
CHROMIE_CONDA_ENV=Chromie

# Debugging.
# LOG_LEVEL=DEBUG
# OLLAMA_AUTO_RESTART_ON_CRASH=1

# Proxy example, if needed.
# HTTP_PROXY=http://host.docker.internal:7897
# HTTPS_PROXY=http://host.docker.internal:7897
# NO_PROXY=localhost,127.0.0.1,host.docker.internal,chromie-asr,chromie-tts,chromie-llm,chromie-agent
# Optional structured Orchestrator event evidence (may contain private speech).
# ORCH_EVENT_LOG_PATH=.chromie/acceptance/manual-events.jsonl

# Optional Runtime Trace. Default-off until a profiling or diagnostic run enables
# it. Values shown are the code defaults.
# CHROMIE_RUNTIME_TRACE_MODE=off
# CHROMIE_RUNTIME_TRACE_MODULES=
# CHROMIE_RUNTIME_TRACE_DEBUG_MODULES=
# CHROMIE_RUNTIME_TRACE_MAX_ITEMS=1000
# CHROMIE_RUNTIME_TRACE_MAX_ATTRIBUTES=32
# CHROMIE_RUNTIME_TRACE_MAX_ATTRIBUTE_CHARS=512
# CHROMIE_RUNTIME_TRACE_COVERAGE=partial
# CHROMIE_RUNTIME_TRACE_EMIT_EVENTS=0
# CHROMIE_RUNTIME_TRACE_EVENT_SAMPLE_RATE=1.0
# CHROMIE_RUNTIME_TRACE_EVENT_MIN_TOTAL_MS=0
# CHROMIE_RUNTIME_TRACE_EVENT_MIN_FIRST_OBSERVABLE_MS=0
# CHROMIE_RUNTIME_TRACE_EVENT_ALWAYS_EMIT_ABANDONED=1
# CHROMIE_RUNTIME_TRACE_RESOURCE_SAMPLING=off
# CHROMIE_RUNTIME_TRACE_ACCELERATOR_SAMPLING=off
# CHROMIE_RUNTIME_TRACE_ACCELERATOR_PROVIDER=auto
# CHROMIE_RUNTIME_TRACE_ACCELERATOR_TIMEOUT_MS=1000
# CHROMIE_RUNTIME_TRACE_ACCELERATOR_MIN_INTERVAL_S=5
# CHROMIE_RUNTIME_TRACE_CHECKPOINT_DIR=.chromie/runtime-trace-checkpoints
# Runtime Trace session lifecycle.
# ORCH_SESSION_IDLE_TIMEOUT_MS=120000
# ORCH_SESSION_IDLE_SWEEP_S=5

# Optional validation overlay. Hardware detection remains automatic.
# CHROMIE_VALIDATION_PROFILE=architecture
