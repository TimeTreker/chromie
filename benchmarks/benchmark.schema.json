{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chromie.local/schemas/benchmark-inventory-v1.json",
  "title": "Chromie Benchmark Scenario Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_version", "generated_from", "scenarios"],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "generated_from": {"type": "string", "minLength": 1},
    "scenarios": {
      "type": "array",
      "items": {"$ref": "#/$defs/scenario"}
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_path", "source_kind", "layer", "datasets", "languages", "evidence_levels", "provenance"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "source_path": {"type": "string", "minLength": 1},
        "source_kind": {"enum": ["scenario_file", "acceptance_entrypoint"]},
        "layer": {"enum": ["module", "integration", "e2e", "stress", "regression"]},
        "datasets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["en", "zh", "mixed", "unknown"]}},
        "evidence_levels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["static", "replay", "live_model", "live_service", "simulated", "physical", "unknown"]}},
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inventory_rule"],
          "properties": {
            "inventory_rule": {"type": "string", "minLength": 1},
            "declared_id": {"type": ["string", "null"]}
          }
        }
      }
    }
  }
}
