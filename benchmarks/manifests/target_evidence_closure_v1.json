{
  "schema_version": 1,
  "closure_id": "chromie.target-evidence-closure.v1",
  "runtime_policy_authority": false,
  "release_qualification_automatic": false,
  "profiles": {
    "source_bound_development": {
      "description": "Close current source-bound development validation without claiming physical-device support.",
      "required_tracks": [
        "gateway_core",
        "agent_skill_weather",
        "social_attention",
        "lan_exposure"
      ],
      "optional_tracks": [
        "physical_voice",
        "physical_robot"
      ]
    },
    "supervised_physical_pilot": {
      "description": "Add supervised physical audio and robot evidence to the source-bound development closure.",
      "required_tracks": [
        "gateway_core",
        "agent_skill_weather",
        "social_attention",
        "lan_exposure",
        "physical_voice",
        "physical_robot"
      ],
      "optional_tracks": []
    },
    "current_revision_qualification": {
      "description": "Qualify the exact current revision across source gates, retained live interaction behavior, live provider fault handling, existing Gateway/weather/Social Attention/LAN tracks, while keeping physical audio and robot claims separate.",
      "required_tracks": [
        "source_qualification",
        "gateway_core",
        "agent_skill_weather",
        "interaction_behavior",
        "provider_faults",
        "social_attention",
        "lan_exposure"
      ],
      "optional_tracks": [
        "physical_voice",
        "physical_robot"
      ]
    }
  },
  "tracks": {
    "gateway_core": {
      "report": "gateway-core/qualification.json",
      "eligibility_path": "qualification.issue_closure_eligible",
      "source_revision_path": "expected_provenance.chromie_revision"
    },
    "agent_skill_weather": {
      "report": "agent-skill-weather/qualification.json",
      "eligibility_path": "qualification.track_closure_eligible",
      "source_revision_path": "expected_provenance.chromie_revision"
    },
    "social_attention": {
      "report": "social-attention/qualification.json",
      "eligibility_path": "qualification.state",
      "eligibility_value": "human_review_required",
      "review": "social-attention/human-review.json",
      "source_revision_list_path": "runs",
      "source_revision_item_path": "code_revision"
    },
    "lan_exposure": {
      "report": "lan-exposure/qualification.json",
      "eligibility_path": "passed",
      "source_revision_path": "source_revision"
    },
    "physical_voice": {
      "report": "physical-voice/verification.json",
      "eligibility_path": "human_voice_device_claim_eligible",
      "source_revision_path": "chromie_revision"
    },
    "physical_robot": {
      "report": "physical-robot/qualification.json",
      "eligibility_path": "physical_robot_claim_eligible",
      "review": "physical-robot/human-review.json",
      "source_revision_path": "chromie_revision"
    },
    "source_qualification": {
      "report": "source/qualification.json",
      "eligibility_path": "source_qualified",
      "source_revision_path": "revision",
      "required_values": {
        "source_clean": true,
        "target_validated": false,
        "release_qualified": false
      }
    },
    "interaction_behavior": {
      "report": "interaction-behavior/qualification.json",
      "eligibility_path": "ok",
      "source_revision_path": "provenance.chromie_revision",
      "required_values": {
        "mode": "live-text",
        "evidence_level": "C",
        "execute": true,
        "assertion_scope": "full",
        "goal_driven_runtime": "apply",
        "provenance.chromie_dirty": false
      }
    },
    "provider_faults": {
      "report": "provider-faults/qualification.json",
      "eligibility_path": "qualification.live_provider_faults_eligible",
      "source_revision_path": "provenance.chromie_revision",
      "required_values": {
        "evidence_source": "live",
        "provenance.chromie_dirty": false
      }
    }
  },
  "social_attention_review_checks": [
    "qualitative_samples_reviewed",
    "none_behavior_remains_acceptable",
    "primary_work_is_not_delayed",
    "backend_identity_and_calibration_are_not_leaked",
    "model_choice_remains_a_human_decision"
  ],
  "physical_robot_review_checks": [
    "safety_operator_present",
    "verified_stop_path",
    "bounded_workspace",
    "provider_source_identity_matches",
    "post_execution_safe_state_confirmed"
  ],
  "interaction_behavior_cases": [
    "user_probe_walk_forward_ten_seconds",
    "multi_goal_walk_then_blink",
    "user_probe_cancel_recent_walk",
    "chongqing_daytime_weather_progress_and_lookup",
    "debug_bundle_run_15_while_singing",
    "multi_goal_blink_and_joke",
    "user_probe_continue_recent_walk",
    "user_probe_current_local_time"
  ],
  "interaction_behavior_claims": {
    "input_channel": "injected_text",
    "requires_execute": true,
    "requires_full_assertion_scope": true,
    "covers": [
      "Chinese and English Planner-owned pre-effect communication",
      "deterministic cancellation without Host result narration",
      "provider-backed external information with Evidence re-entry",
      "multi-goal body/conversation execution and normal DAG continuation",
      "retained Goal continuity across follow-up turns",
      "duplicate-effect resistance through observation cardinality in retained cases",
      "warm Fast-Planner commitment and playback-start budgets where the case declares them"
    ],
    "does_not_prove": [
      "physical microphone",
      "audible speaker",
      "physical robot"
    ]
  }
}
