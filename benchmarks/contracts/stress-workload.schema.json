{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chromie.local/schemas/stress-workload-manifest-v1.json",
  "title": "Chromie Stress Workload Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime_policy_authority",
    "metrics_are_observational",
    "release_qualification",
    "comparison_dimensions",
    "workloads"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "runtime_policy_authority": {"const": false},
    "metrics_are_observational": {"const": true},
    "release_qualification": {"const": "human_approval_required"},
    "comparison_dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "workloads": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "evidence_profile",
          "sample_count",
          "session_count",
          "concurrency",
          "seed",
          "selector",
          "sequence",
          "participants",
          "conditions",
          "observations",
          "description"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {
            "enum": [
              "long_session",
              "repetition_cooldown",
              "interruption",
              "concurrency",
              "provider_degradation",
              "multi_user"
            ]
          },
          "evidence_profile": {"type": "string", "minLength": 1},
          "sample_count": {"type": "integer", "minimum": 1, "maximum": 10000},
          "session_count": {"type": "integer", "minimum": 1},
          "concurrency": {"type": "integer", "minimum": 1, "maximum": 256},
          "seed": {"type": "integer", "minimum": 0},
          "selector": {"type": "object"},
          "sequence": {"type": "object"},
          "participants": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "conditions": {"type": "object"},
          "observations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "description": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
