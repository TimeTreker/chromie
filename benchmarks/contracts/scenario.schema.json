{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chromie.local/schemas/benchmark-scenario-v1.json",
  "title": "Chromie Normalized Benchmark Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "layer", "datasets", "source", "inputs", "context", "capabilities", "expectations", "evidence_requirements", "review_rubric", "legacy_expectations"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "layer": {"enum": ["module", "integration", "e2e", "stress", "regression"]},
    "datasets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "adapter", "source_index", "source_id"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "adapter": {"type": "string", "minLength": 1},
        "source_index": {"type": ["integer", "null"], "minimum": 0},
        "source_id": {"type": ["string", "null"]}
      }
    },
    "inputs": {"type": "object", "minProperties": 1},
    "context": {"type": "object"},
    "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_outcomes", "acceptable_auxiliary", "forbidden_behaviors", "invariants", "distribution_observations"],
      "properties": {
        "primary_outcomes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "acceptable_auxiliary": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "forbidden_behaviors": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "invariants": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "distribution_observations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "anyOf": [
        {"properties": {"primary_outcomes": {"minItems": 1}}},
        {"properties": {"invariants": {"minItems": 1}}}
      ]
    },
    "evidence_requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["static", "replay", "live_model", "live_service", "simulated", "physical", "unknown"]}},
    "review_rubric": {"type": "object"},
    "legacy_expectations": {"type": "object"}
  }
}
