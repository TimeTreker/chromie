{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chromie.local/schemas/e2e-suite-result-v1.json",
  "title": "Chromie E2E Benchmark Suite Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run", "profile", "summary", "qualification", "results"],
  "properties": {
    "schema_version": {"const": 1},
    "run": {"type": "object"},
    "profile": {"type": "object"},
    "summary": {
      "type": "object",
      "required": ["total", "pass", "fail", "review", "error", "evidence_complete", "evidence_partial", "evidence_missing"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "pass": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "review": {"type": "integer", "minimum": 0},
        "error": {"type": "integer", "minimum": 0},
        "evidence_complete": {"type": "integer", "minimum": 0},
        "evidence_partial": {"type": "integer", "minimum": 0},
        "evidence_missing": {"type": "integer", "minimum": 0}
      }
    },
    "qualification": {
      "type": "object",
      "required": ["release_qualified", "human_approval_required", "state", "claim_ceiling"],
      "properties": {
        "release_qualified": {"const": false},
        "human_approval_required": {"type": "boolean"},
        "state": {"enum": ["not_eligible", "evidence_incomplete", "human_review_required", "evidence_complete"]},
        "claim_ceiling": {"type": "array", "items": {"type": "string"}}
      }
    },
    "results": {"type": "array", "items": {"type": "object"}}
  }
}
