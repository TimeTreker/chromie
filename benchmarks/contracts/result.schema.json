{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chromie.local/schemas/benchmark-result-v1.json",
  "title": "Chromie Benchmark Result Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "status",
    "run",
    "observations",
    "evaluation",
    "invariant_results",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "run": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "mode",
        "evidence_level"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "evidence_level": {
          "enum": [
            "static",
            "replay",
            "live_model",
            "live_service",
            "simulated",
            "physical",
            "unknown"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt_revision": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "primary_outcome": {},
        "auxiliary_behavior": {},
        "latency_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "evidence": {
          "type": "array"
        },
        "primary_task_passed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "behaviors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "invariant_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "passed",
          "detail"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "review"
      ]
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_review_required",
        "forbidden_behavior_hits"
      ],
      "properties": {
        "semantic_review_required": {
          "type": "boolean"
        },
        "forbidden_behavior_hits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "oracle_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "deterministic_sources",
            "semantic_dimensions",
            "semantic_blocking"
          ],
          "properties": {
            "mode": {
              "enum": ["deterministic", "semantic_review", "hybrid"]
            },
            "deterministic_sources": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            },
            "semantic_dimensions": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            },
            "semantic_blocking": {"type": "boolean"}
          }
        },
        "deterministic_status": {
          "enum": ["pass", "fail"]
        },
        "semantic_review_status": {
          "enum": ["not_required", "pending", "pass", "partial", "fail", "insufficient_evidence"]
        },
        "semantic_review": {
          "type": "object"
        },
        "semantic_review_effect": {
          "enum": ["accepted", "diagnostic_only", "requires_follow_up"]
        }
      }
    }
  }
}
