        "tests/test_execution_outcome_reconciliation.py",
        "tests/test_capability_result_evidence_reentry.py",
        "tests/test_work_dag_revision.py",
        "tests/test_work_dag_execution_state.py",
        "tests/test_detached_capability_cognitive_reentry.py"
