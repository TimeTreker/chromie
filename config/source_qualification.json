      "dependency": "pytest==9.1.1"
    },
    {
      "id": "current_revision_cognition_regression",
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests/test_goal_interpreter_llm_prompt.py",
        "tests/test_goal_association_pr2.py",
        "tests/test_fast_planner_pr3.py",
        "tests/test_deep_planner_pr4.py",
        "tests/test_work_dag_planning.py",
        "tests/test_work_dag_revision.py",
        "tests/test_work_dag_execution_state.py",
        "tests/test_cognitive_turn_loop_closure.py",
        "tests/test_fast_planner_streaming_commit.py",
        "tests/test_planner_auxiliary_activity_contract.py",
        "tests/test_cognitive_runtime_pr7.py",
        "tests/test_conversation_state.py",
        "tests/test_situation_projection.py",
        "tests/test_cognitive_gateway_reflex.py"
      ],
      "dependency": "pytest==9.1.1"
    },
    {
      "id": "general_ability_level_a",
      "argv": [
        "{python}",
        "scripts/general_ability_acceptance.py",
        "--mode",
        "level-a",
        "--no-write"
      ]
    },
    {
      "id": "provider_fault_matrix_level_a",
      "argv": [
        "{python}",
        "scripts/provider_fault_matrix.py"
      ]
    },
    {
      "id": "ruff",
      "argv": [
        "{python}",
        "scripts/run_ruff.py"
      ],
      "dependency": "ruff==0.16.0"
    },
    {
      "id": "mypy",
      "argv": [
        "{python}",
        "scripts/run_mypy.py"
      ],
      "dependency": "mypy==2.3.0"
    },
    {
      "id": "maintained_tests",
      "argv": [
        "./scripts/run_tests.sh"
      ],
      "full_suite": true
    }
  ],
  "excluded_target_claims": [
    "microphone input",
    "audible speaker output",
    "audio-device hot-plug",
    "shared-GPU target latency",
    "MuJoCo or physical robot execution",
    "second-machine LAN reachability",
    "release qualification"
  ]
}
